# secrets / envs
.env
.venv/
__pycache__/
*.pyc
node_modules/

# heavy or personal media
episodes/*/voice/*
!episodes/*/voice/.gitkeep
episodes/*/output/*
!episodes/*/output/.gitkeep
episodes/*/build/
episodes/*/.cache/
assets/inbox/*
!assets/inbox/.gitkeep
brand/_audition/files/

# model caches / tools
tools/
.cache/
*.log
.DS_Store
!episodes/*/voice/tts.txt
!episodes/*/voice/voice.json
episodes/*/voice/audition/
components/_gallery/project/
components/_gallery/snaps/
assets/snapshots/*.html

# graphify: keep graph.json + GRAPH_REPORT.md in git, not the extraction cache
graphify-out/cache/
graphify-out/.graphify_python

# source cache (re-download with pipeline/facts_library.py cache <url>); index.json stays in git
brand/sources/*
!brand/sources/index.json
