{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python pipeline/*)",
      "Bash(npx --yes ccusage@20.0.28:*)",
      "Bash(npx ccusage@20.0.28:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(pgrep:*)",
      "Bash(mkdir:*)",
      "Bash(tail:*)",
      "Bash(head:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(date:*)",
      "Bash(sleep:*)",
      "Bash(systemd-inhibit --what=sleep:idle --who=chillar-batch --why=\"reel batch\" --mode=block sleep 43200)",
      "Bash(systemd-inhibit --list)",
      "Bash(graphify query:*)",
      "Bash(graphify path:*)",
      "Bash(graphify explain:*)",
      "Bash(graphify update .)",
      "Bash(ffprobe:*)",
      "Edit(./**)"
    ],
    "deny": [
      "Bash(.venv/bin/python pipeline/..*)",
      "Edit(./.claude/settings*.json)",
      "Edit(./.env*)",
      "Edit(./.git/**)",
      "Edit(./.venv/**)",
      "Read(./.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/home/khare/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/khare/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  }
}
