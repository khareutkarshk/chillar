{
  "brand": {
    "name": "Chillar",
    "handle": "@chillar.ind",
    "instagram": "https://www.instagram.com/chillar.ind/"
  },
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "theme": "pastel",
  "themes": {
    "pastel": {
      "palette": {
        "ink": "#1E1B18",
        "paper": "#FFFDF9",
        "pencil": "#7A746A",
        "red": "#C9473B",
        "pen": "#2F4FA3",
        "green": "#3E9A62",
        "haldi": "#F6CF5C",
        "greenText": "#2B7A4B"
      },
      "fields": {
        "bone": {
          "bg": "#F1EEE8",
          "ink": "#1E1B18"
        },
        "note10": {
          "bg": "#D9C3B0",
          "ink": "#3A2618"
        },
        "note20": {
          "bg": "#E2E6B8",
          "ink": "#2E3317"
        },
        "note50": {
          "bg": "#CFE6EE",
          "ink": "#13364A"
        },
        "note500": {
          "bg": "#DAD6CC",
          "ink": "#2B2924"
        },
        "note2000": {
          "bg": "#F0D0DD",
          "ink": "#5A1E38"
        }
      },
      "about": "Soft Rupee — the rupee-note colours softened to milk-tea pastels"
    },
    "calm": {
      "palette": {
        "ink": "#1C1C1A",
        "paper": "#FFFEFB",
        "pencil": "#77736B",
        "red": "#B9443A",
        "pen": "#2C4E9A",
        "green": "#3B8F5E",
        "haldi": "#F3D27A",
        "greenText": "#2A7048"
      },
      "fields": {
        "bone": {
          "bg": "#F2F0EB",
          "ink": "#1C1C1A"
        },
        "note10": {
          "bg": "#DDE4D5",
          "ink": "#223A2E"
        },
        "note20": {
          "bg": "#D8E3EC",
          "ink": "#1D3550"
        },
        "note50": {
          "bg": "#ECE3D1",
          "ink": "#45351F"
        },
        "note500": {
          "bg": "#E9D8DA",
          "ink": "#4F2836"
        },
        "note2000": {
          "bg": "#CBD2D8",
          "ink": "#222C36"
        }
      },
      "about": "Tone-on-tone — sage, powder blue, sand, dusty rose, slate, each with a deep ink of its own hue"
    },
    "night": {
      "palette": {
        "ink": "#1B1814",
        "paper": "#F7F1E6",
        "pencil": "#857C6E",
        "red": "#D9533F",
        "pen": "#2F55C4",
        "green": "#3FAE73",
        "haldi": "#F2C14E",
        "greenText": "#2E8A57"
      },
      "fields": {
        "bone": {
          "bg": "#1F1E1B",
          "ink": "#F2EEE6"
        },
        "note10": {
          "bg": "#1B3A33",
          "ink": "#F3EDE1"
        },
        "note20": {
          "bg": "#1A2740",
          "ink": "#EEF1F6"
        },
        "note50": {
          "bg": "#2E241F",
          "ink": "#F4E9DC"
        },
        "note500": {
          "bg": "#133B44",
          "ink": "#E9F4F4"
        },
        "note2000": {
          "bg": "#4A1F27",
          "ink": "#F6E6E6"
        }
      },
      "about": "Night desk — deep forest, midnight, espresso, teal, oxblood; warm paper under a lamp"
    }
  },
  "fieldSlots": {
    "bone": "plain page: outro, calm beats",
    "note10": "chapter 1 — the opener",
    "note20": "chapter 2",
    "note50": "chapter 3",
    "note500": "chapter 4 — biggest stakes",
    "note2000": "the twist / myth chapter"
  },
  "fieldSequence": [
    "note10",
    "note20",
    "note50",
    "note500"
  ],
  "paletteRules": {
    "haldiNeverText": true,
    "greenTextOnlyUses": "greenText",
    "penIsHandwritingOnly": true,
    "monoOnlyInsidePrintouts": true,
    "noGradients": true,
    "noNeon": true,
    "noTrackedCapsLabels": true,
    "noEyebrows": true,
    "shadowsOnlyUnderPaperObjects": true,
    "fieldLightSameHueOnly": true
  },
  "fonts": {
    "headline": "Bricolage Grotesque",
    "headlineWeight": 800,
    "headlineStack": "'Bricolage Grotesque', 'Mukta', sans-serif",
    "body": "Mukta",
    "bodyWeight": 800,
    "print": "JetBrains Mono",
    "printStack": "'JetBrains Mono', 'Mukta', monospace",
    "case": "sentence case headlines"
  },
  "object": {
    "radius": 8,
    "restingTiltDeg": [
      -2.2,
      2.2
    ],
    "shadow": "soft contact + ambient, tinted --shadow-rgb"
  },
  "safeZone": {
    "top": 220,
    "bottom": 420,
    "left": 60,
    "right": 140,
    "captionBand": [
      1150,
      1450
    ],
    "coverGridCrop": {
      "x": 0,
      "y": 240,
      "w": 1080,
      "h": 1440
    }
  },
  "motion": {
    "entranceFrames": [
      5,
      7
    ],
    "entranceEase": "power3.out",
    "overshootOnlyFor": [
      "mascot-reaction",
      "stamp"
    ],
    "stampScaleFrom": 1.4,
    "stampShakeFrames": 2,
    "maxSecondsBetweenVisualChanges": 3.0,
    "minSecondsBetweenSfx": 2.0
  },
  "transitions": {
    "styles": [
      "cut",
      "whip",
      "zoom",
      "wipe",
      "page"
    ],
    "default": "cut",
    "maxNonCutPerVideo": {
      "30": 1,
      "60": 2,
      "90": 3
    },
    "minSecondsBetweenNonCut": 12.0,
    "neverShowText": true
  },
  "formats": {
    "30": {
      "seconds": [
        27,
        36
      ],
      "words": [
        70,
        95
      ],
      "chapters": [
        3,
        3
      ],
      "stamps": [
        1,
        2
      ],
      "rehookEvery": 10.0
    },
    "60": {
      "seconds": [
        52,
        68
      ],
      "words": [
        140,
        180
      ],
      "chapters": [
        4,
        4
      ],
      "stamps": [
        2,
        3
      ],
      "rehookEvery": 16.0
    },
    "90": {
      "seconds": [
        80,
        98
      ],
      "words": [
        215,
        260
      ],
      "chapters": [
        5,
        5
      ],
      "stamps": [
        3,
        3
      ],
      "rehookEvery": 18.0
    }
  },
  "audio": {
    "voiceLufs": -14,
    "truePeak": -1.0,
    "musicUnderVoiceDb": [
      -24,
      -20
    ]
  },
  "instagram": {
    "source": "https://developers.facebook.com/docs/instagram-platform/instagram-graph-api/reference/ig-user/media (Reels specs, checked 2026-10-19)",
    "metaLimits": {
      "container": [
        "mp4",
        "mov"
      ],
      "videoCodec": [
        "h264",
        "hevc"
      ],
      "chroma": "4:2:0",
      "scan": "progressive",
      "gop": "closed",
      "fps": [
        23,
        60
      ],
      "maxWidth": 1920,
      "maxVideoBitrateMbps": 25,
      "audioCodec": "aac",
      "audioMaxSampleRate": 48000,
      "audioChannels": [
        1,
        2
      ],
      "audioBitrateKbps": 128,
      "durationSec": [
        3,
        900
      ],
      "maxFileMB": 300,
      "moovAtFront": true,
      "noEditLists": true,
      "cover": {
        "format": "jpeg",
        "maxMB": 8,
        "colorSpace": "sRGB",
        "aspect": "9:16"
      }
    },
    "export": {
      "container": "mp4",
      "videoCodec": "h264",
      "profile": "high",
      "level": "4.2",
      "pixFmt": "yuv420p",
      "width": 1080,
      "height": 1920,
      "fps": 30,
      "crf": 18,
      "maxrateMbps": 16,
      "bufsizeMbps": 32,
      "gopFrames": 30,
      "color": "bt709",
      "audioCodec": "aac",
      "audioBitrateKbps": 128,
      "audioSampleRate": 48000,
      "audioChannels": 2,
      "why": "H.264 not HEVC (some phones/IG transcodes glitch on HEVC uploads); 30 fps CFR; 1 s closed GOP; capped VBR well under 25 Mbps; BT.709 tagged so colours don't shift; faststart, no edit lists"
    }
  },
  "wordmark": {
    "box": {
      "x": 72,
      "y": 1460,
      "w": 420,
      "h": 40
    },
    "note": "bottom-left, just under the caption band, inside the safe zone; on every frame except the outro"
  },
  "mascot": {
    "coin": "#FFC83D",
    "ink": "#151515",
    "paper": "#FAF9F6",
    "pencil": "#6B675E",
    "green": "#1E9E58",
    "red": "#D9302C"
  }
}
