# Copy to .env and fill in. Never commit .env.

# https://freesound.org/apiv2/apply  (token auth → HQ previews; good enough for SFX)
FREESOUND_API_KEY=
# Optional: OAuth2 access token for original-quality Freesound downloads
FREESOUND_OAUTH_TOKEN=

# https://pixabay.com/api/docs/  (images + video via API; audio is scraped politely)
PIXABAY_API_KEY=

# https://www.pexels.com/api/  (photos + video; use sparingly)
PEXELS_API_KEY=

# Scraper politeness (seconds between page loads, max items per query)
SCRAPE_DELAY_MIN=3
SCRAPE_DELAY_MAX=5
SCRAPE_MAX_ITEMS=5

# https://dashboard.sarvam.ai  (Bulbul TTS — Hinglish voiceover)
SARVAM_API_KEY=
